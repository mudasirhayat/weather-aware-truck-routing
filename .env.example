# Copy to backend/.env or export before running. Every value has a working
# default; nothing here is required to run locally.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Upstream providers (all keyless by default) --------------------------
# Identify yourself to Nominatim / OSRM / Open-Meteo, as their policies ask.
OUTBOUND_USER_AGENT=weather-aware-truck-routing/1.0 (you@example.com)
# Point at your own OSRM if you have one (e.g. a truck-profile build).
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving

# --- Timeouts and caching -------------------------------------------------
ROUTING_TIMEOUT_SECONDS=25
WEATHER_TIMEOUT_SECONDS=25
GEOCODE_TIMEOUT_SECONDS=10
WEATHER_CACHE_SECONDS=900
ROUTING_CACHE_SECONDS=86400
GEOCODE_CACHE_SECONDS=604800
# Optional: share the cache across workers instead of per-process memory.
# REDIS_URL=redis://localhost:6379/0

# --- Planning limits ------------------------------------------------------
MAX_ROUTE_OPTIONS=3
HEATMAP_MAX_POINTS=70
HEATMAP_MIN_SPACING_MILES=5
HEATMAP_HOURS=48

# --- Frontend (build time) ------------------------------------------------
# Only needed if the API is on a different origin than the UI.
# VITE_API_BASE_URL=https://api.example.com/api
